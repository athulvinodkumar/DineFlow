# ==============================================================
# DineFlow Environment Configuration (.env.example)
# Copy this file to .env for local development
# For Vercel deployment, add these variables in your Project Settings > Environment Variables
# ==============================================================

# Database Connection Strings (PostgreSQL - Neon, Supabase, or Vercel Postgres)
# DATABASE_URL: Pooled connection string (used at runtime by serverless functions)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct unpooled connection string (used for migrations: prisma migrate deploy)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (Must be a secure random 32+ char string in production)
JWT_SECRET="dineflow-super-secret-jwt-key-2026-production"

# Local Server Port (default 5000 for local development)
PORT=5000

# Vercel Cron Secret (Optional but recommended to secure /api/cron/* endpoints)
CRON_SECRET="your-secure-cron-secret-key-12345"

# Real-time Provider (Pusher Channels)
# Sign up free at https://pusher.com/channels
# (If not provided, DineFlow automatically uses built-in HTTP polling fallback)
PUSHER_APP_ID="1234567"
PUSHER_KEY="sample_pusher_key"
PUSHER_SECRET="sample_pusher_secret"
PUSHER_CLUSTER="ap2"

# Frontend Vite Pusher Credentials (Must match PUSHER_KEY and PUSHER_CLUSTER)
VITE_PUSHER_KEY="sample_pusher_key"
VITE_PUSHER_CLUSTER="ap2"
