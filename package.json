{
  "name": "dineflow",
  "version": "1.0.0",
  "description": "DineFlow - Full-Stack Multi-Tenant Restaurant Management System (Vercel Serverless + React Vite)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue,green\" \"tsx watch api/index.ts\" \"vite\"",
    "dev:api": "tsx watch api/index.ts",
    "dev:client": "vite",
    "build": "prisma generate && vite build",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test": "tsx test/run-all-tests.ts",
    "test:all": "tsx test/run-all-tests.ts",
    "test:e2e": "tsx test/run-all-tests.ts",
    "test:display": "tsx test/test-display-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "pg-gateway": "^0.3.0-beta.4",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
