datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Restaurant {
  id                   String            @id @default(cuid())
  code                 String            @unique // e.g. RST-48213
  name                 String
  ownerName            String
  email                String            @unique
  phone                String
  address              String
  gstin                String?
  upiId                String?           // e.g. spicebistro@okhdfcbank
  serviceChargePercent Float             @default(5.0)
  taxPercent           Float             @default(5.0)
  billHeader           String?
  billFooter           String?
  showItemizedBillOnDisplay Boolean       @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  adminUsers           AdminUser[]
  staffUsers           StaffUser[]
  categories           Category[]
  menuItems            MenuItem[]
  tables               RestaurantTable[]
  orders               Order[]
  bills                Bill[]
  payments             Payment[]
}

model AdminUser {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN")
  createdAt    DateTime   @default(now())
}

model StaffUser {
  id                  String     @id @default(cuid())
  restaurantId        String
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId              String     // e.g. "Root", "waiter1", "Display1", unique within restaurant
  name                String
  passwordHash        String
  role                String     // "BILLING" | "WAITER" | "KITCHEN" | "CUSTOMER_DISPLAY"
  linkedBillingUserId String?    // Optional link to a specific Billing staff userId (for CUSTOMER_DISPLAY)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([restaurantId, userId])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  menuItems    MenuItem[]
}

model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Float
  isVeg        Boolean     @default(true)
  isAvailable  Boolean     @default(true)
  taxPercent   Float       @default(5.0)
  imageUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orderItems   OrderItem[]
}

model RestaurantTable {
  id             String      @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber    String      // e.g. "Table 1"
  capacity       Int         @default(4)
  status         String      @default("FREE") // "FREE" | "OCCUPIED" | "BILLING"
  currentOrderId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orders         Order[]
}

model Order {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderNumber  String           // e.g. "ORD-1001"
  tableId      String?
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiterId     String?
  waiterName   String?
  orderType    String           @default("DINE_IN") // "DINE_IN" | "TAKEAWAY"
  status       String           @default("PENDING") // "PENDING" | "PREPARING" | "READY" | "SERVED" | "COMPLETED" | "CANCELLED"
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  items        OrderItem[]
  bill         Bill?
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int      @default(1)
  status     String   @default("PENDING") // "PENDING" | "PREPARING" | "READY" | "SERVED" | "CANCELLED"
  notes      String?
  kotNumber  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Bill {
  id                   String      @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  billNumber           String      // unique within restaurant
  orderId              String?     @unique
  order                Order?      @relation(fields: [orderId], references: [id])
  tableName            String?
  subtotal             Float
  taxPercent           Float       @default(5.0)
  taxAmount            Float
  serviceChargePercent Float       @default(5.0)
  serviceChargeAmount  Float
  discountType         String      @default("NONE") // "NONE" | "PERCENT" | "FLAT"
  discountValue        Float       @default(0.0)
  discountAmount       Float       @default(0.0)
  grandTotal           Float
  paymentStatus        String      @default("PENDING") // "PENDING" | "PAID"
  paymentMode          String?     // "UPI" | "CASH" | "CARD"
  paymentSessionStatus String      @default("IDLE") // "IDLE" | "PENDING" | "CONFIRMED" | "CANCELLED"
  cashierUserId        String?     // StaffUser.userId of cashier initiating/managing payment
  paymentInitiatedAt   DateTime?
  transactionRef       String?
  paidAt               DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  payments             Payment[]

  @@unique([restaurantId, billNumber])
}

model Payment {
  id             String     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  billId         String
  bill           Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount         Float
  paymentMode    String     // "UPI" | "CASH" | "CARD"
  transactionRef String
  status         String     @default("SUCCESS")
  createdAt      DateTime   @default(now())
}
